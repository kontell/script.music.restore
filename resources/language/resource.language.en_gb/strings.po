msgid "Recent queues"
msgstr ""

msgctxt "#30011"
msgid "Recent queues"
msgstr ""

msgctxt "#30012"
msgid "Nothing has been set aside yet. A queue is saved whenever one is replaced, interrupted or stopped."
msgstr ""

