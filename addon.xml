<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The script extension point comes first deliberately: an addon's LibPath is
     taken from its first <extension>, and that is what RunScript resolves when
     the skin's "Recent queues" widget button fires. -->
<addon id="script.music.restore" name="Restore Music Queue" version="0.3.4" provider-name="kontell">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/kontell/script.music.restore</source>
    <summary lang="en_GB">Bring back a music queue you were part-way through</summary>
    <description lang="en_GB">Records the music queue and playback position every time music is stopped. Resume playback from a list of previous queues by running the add-on.</description>
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <assets>
      <icon>resources/button.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
