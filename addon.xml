<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The script extension point comes first deliberately: an addon's LibPath and
     main type are taken from its first <extension>, and LibPath is what
     RunScript resolves. Verified on Kodi 21.3 that plugin:// still resolves to
     main.py with pluginsource listed second, so both entry points work. -->
<addon id="script.music.restore" name="Restore Music Queue" version="0.2.0" provider-name="kontell">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>audio</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/kontell/script.music.restore</source>
    <summary lang="en_GB">Bring back a music queue you were part-way through</summary>
    <description lang="en_GB">Records the music queue every time it is taken away — when a new album replaces it, when a video interrupts it, when playback is stopped, and when Kodi quits — along with which track you were on and how far into it. Pick one back off the list and it resumes on the right track at the right second. Reached from the "Recent queues" button in the skin's music categories row, or by running the addon.</description>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
